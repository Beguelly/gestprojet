# Copie este arquivo para ".env" e preencha. O .env nunca vai para o GitHub.

# "sim" liga a IA. Qualquer outro valor mantém o modo demonstração.
IA_LIGADA=sim

# Provedor: google ou anthropic
IA_PROVEDOR=google

# Chave da API do Gemini, criada em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo (opcional; padrão gemini-3.5-flash-lite)
# GEMINI_MODELO=

# Só se IA_PROVEDOR=anthropic: chave criada em https://platform.claude.com
ANTHROPIC_API_KEY=

# Agenda: WhatsApp por API não oficial (só no computador). Risco de bloqueio do número.
WHATSAPP_LIGADO=nao

# Agenda: e-mail automático. No Gmail, crie uma "senha de app" em
# https://myaccount.google.com/apppasswords (exige verificação em duas etapas).
EMAIL_LIGADO=nao
SMTP_USUARIO=
SMTP_SENHA=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=465

# Porta local (opcional)
PORT=3000
